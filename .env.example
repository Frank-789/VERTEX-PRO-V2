# 复制成 .env 再填。.env 已在 .gitignore 里 —— 千万别提交。
#
# 第一代的 .env.example 里放了一个真实可用的 DeepSeek key 并且提交到了公开仓库，
# 结果就是任何人 clone 下来都能拿去用。这个文件里**永远只放变量名和占位符**。

# ── AI 供应商（至少配一个，否则对话直接报错）─────────────────
# 变量名要和 config/providers.json 里的 api_key_env 对得上
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# ── 数据采集（不配的话对应工具会显示「未配置」，不会伪造数据）──
APIFY_TOKEN=
APIFY_DEFAULT_ACTOR=
# 按平台单独指定 Actor，例如：
# APIFY_ACTOR_AMAZON=junglee/amazon-crawler
# APIFY_ACTOR_SHOPEE=

EBAY_API_KEY=
EBAY_MARKETPLACE=EBAY_US

# ── 运行期（通常不用改）──────────────────────────────────────
# 可写状态根目录。容器里挂卷到这个路径即可持久化。
# DATA_HOME=/data
LOG_LEVEL=INFO

# 事件日志（data/event-log/，按天分文件，保留 30 天）。
# 记录每轮的工具调用与完整返回，用来排障和算成本。设 0 就完全不写。
# EVENT_LOG=1

# ── 定时任务（data/issues/）──────────────────────────────────
# 往 data/issues/ 丢一个带 when: 的 .md 就是一个定时任务，详见 docs/04-定时任务.md。
#
# 整个调度器开关。设 0 就只保留「手动触发」，不跑后台循环。
# 测试环境务必设 0 —— 否则后台循环会干扰断言。
# ISSUE_SCHEDULER=1

# 扫描间隔（秒）。任务最多晚这么久才被发现，代价仅此而已（判据是「上次跑之后
# 有没有命中过」，不是「此刻是否命中」），所以调大一点没有副作用。
# ISSUE_TICK_SECONDS=30

# 单轮最多执行几个任务。防止机器睡一夜醒来，二十个任务同时开跑把供应商
# 并发配额一次打满。没轮到的下一轮继续 —— 任务欠着，不会丢。
# ISSUE_MAX_PER_TICK=5

# when: 里没写 timezone 时用哪个。默认东八区 —— 这是给国内商家用的产品，
# 默认 UTC 只会让「早上九点」变成下午五点。
# ISSUE_DEFAULT_TZ=Asia/Shanghai
