# 复制成 .env 再填。.env 已在 .gitignore 里 —— 千万别提交。
#
# 第一代的 .env.example 里放了一个真实可用的 DeepSeek key 并且提交到了公开仓库，
# 结果就是任何人 clone 下来都能拿去用。这个文件里**永远只放变量名和占位符**。

# ── AI 供应商（至少配一个，否则对话直接报错）─────────────────
# 变量名要和 config/providers.json 里的 api_key_env 对得上
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# ── 数据采集（不配的话对应工具会显示「未配置」，不会伪造数据）──
APIFY_TOKEN=
APIFY_DEFAULT_ACTOR=
# 按平台单独指定 Actor，例如：
# APIFY_ACTOR_AMAZON=junglee/amazon-crawler
# APIFY_ACTOR_SHOPEE=

EBAY_API_KEY=
EBAY_MARKETPLACE=EBAY_US

# ── 运行期（通常不用改）──────────────────────────────────────
# 可写状态根目录。容器里挂卷到这个路径即可持久化。
# DATA_HOME=/data
LOG_LEVEL=INFO
