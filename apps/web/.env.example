# 后端地址 —— 仅供 Next.js 服务端 rewrites 使用（不打包进浏览器）
API_ORIGIN=http://localhost:8000

# ---------------------------------------------------------------------------
# 注意：这里不要放任何密钥。
#
# 第一代项目把 DEEPSEEK_API_KEY / KIMI_API_KEY / IMAGE_API_KEY 以 NEXT_PUBLIC_
# 前缀暴露给浏览器，导致任何访客都能从 DevTools 取走密钥盗刷。
